<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="neocam" name="NeoCam"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#f7f9fc"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="root" value="NEOCAM" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#172d47;strokeColor=#172d47;fontColor=#ffffff;fontSize=25;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="650" y="35" width="300" height="75" as="geometry" /></mxCell><mxCell id="solo" value="1. HOẠT ĐỘNG ĐỘC LẬP" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#2869a6;strokeColor=#2869a6;fontColor=#ffffff;fontSize=20;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="240" y="155" width="360" height="75" as="geometry" /></mxCell><mxCell id="combined" value="2. KẾT HỢP" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#7358a4;strokeColor=#7358a4;fontColor=#ffffff;fontSize=20;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1040" y="155" width="320" height="75" as="geometry" /></mxCell><mxCell id="photo" value="CHỤP ẢNH&#10;&#10;•  Nút chụp → lưu ảnh&#10;•  Chỉ báo thành công hoặc lỗi&#10;•  Không có màn hình ngắm" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1f1ff;strokeColor=#266ca6;fontColor=#26344a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="30" y="305" width="355" height="160" as="geometry" /></mxCell><mxCell id="video" value="QUAY VIDEO&#10;&#10;•  Bắt đầu / dừng bằng nút&#10;•  Ghi hình và âm thanh&#10;•  Chất lượng và thời lượng cần thử" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f3eaff;strokeColor=#7951a5;fontColor=#26344a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="415" y="305" width="355" height="160" as="geometry" /></mxCell><mxCell id="ui" value="NÚT VÀ CHỈ BÁO&#10;&#10;•  Bật / tắt, chụp, quay&#10;•  Báo đang quay, lỗi, pin yếu&#10;•  Quy ước điều khiển: đề xuất" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a46a20;fontColor=#26344a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="30" y="525" width="355" height="160" as="geometry" /></mxCell><mxCell id="storage" value="LƯU VÀ TRUY XUẤT&#10;&#10;•  Thẻ microSD lưu ảnh / video&#10;•  Thiếu hoặc đầy thẻ: báo lỗi&#10;•  Đọc thẻ trên máy tính để xem" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4f6eb;strokeColor=#38835d;fontColor=#26344a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="415" y="525" width="355" height="160" as="geometry" /></mxCell><mxCell id="power" value="PIN VÀ SẠC&#10;&#10;•  Pin riêng; đo điện khi sử dụng&#10;•  Chọn dung lượng theo thời lượng&#10;•  Hai tiếp điểm sạc phía sau" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff4d8;strokeColor=#a87b20;fontColor=#26344a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="30" y="745" width="355" height="160" as="geometry" /></mxCell><mxCell id="privacy" value="VỎ VÀ RIÊNG TƯ&#10;&#10;•  Nắp che, đèn báo camera&#10;•  Nam châm và phụ kiện gắn&#10;•  Xét nhiệt, kích thước, sửa chữa" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe7e6;strokeColor=#ab4f4d;fontColor=#26344a;fontSize=16;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="415" y="745" width="355" height="160" as="geometry" /></mxCell><mxCell id="empty" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#9c8ec0;fontColor=#26344a;fontSize=16;align=center;verticalAlign=middle;spacingLeft=14;spacingRight=14;dashed=1;dashPattern=8 6;" vertex="1" parent="1"><mxGeom