(text "USB -> IN1; protected BAT -> IN2; both OUT pins -> VIN_SYS." (at 20.32 222.25 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "cd78ed1b-1a9a-459f-b0b5-7faffacbd156"))
(text "C8/C9/C10: 3x KEMET T520X337M010ATE025, polarized polymer tantalum, 25mOhm each." (at 20.32 229.87 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "866ac685-7bc3-44c1-bdce-c6dcb08bed90"))
(text "Bulk PLUS = VIN_SYS; MINUS = GND. Land pattern and effective capacitance require verification." (at 20.32 237.49 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "b6ae0cc9-8ebf-4809-be26-9eb14fd53704"))
(text "ACCEPTANCE (not TI maxima): tgap<=50us, Qreverse<=20uC, Ceff_total>=750uF, ESR<=15mOhm." (at 20.32 250.19 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "68aabdaa-b048-4b8f-af76-139d89305fe0"))
(text "1A hold-up load; Icap_peak<=3A; ESL/routing20mV; normal I_SYS<=0.9A." (at 20.32 257.81 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "dcbe75a6-748b-4597-bcf7-f1f3a666d097"))
(text "IN2 >=3.8V loaded; modeled VIN minimum3.542V under these budgets; SS ramp <=200V/s is a target." (at 20.32 265.43 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "72f137dd-c77c-4eff-8387-b5cc0bc7cf6c"))
(text "TI 5us is TYPICAL. USB/pin no-reset, startup/inrush and reverse charge remain unqualified." (at 20.32 274.32 0) (effects (font (size 1.15 1.15)) (justify left top)) (uuid "f7468126-15c9-4dfc-ae9d-88b393f11d44"))
